<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
        xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="http://una.ac.cr/gimnasio/soap/cursos"
        targetNamespace="http://una.ac.cr/gimnasio/soap/cursos"
        name="CursoService">

    <wsdl:types>
        <xs:schema>
            <xs:import
                    namespace="http://una.ac.cr/gimnasio/soap/cursos"
                    schemaLocation="cursos.xsd"/>
        </xs:schema>
    </wsdl:types>

    <wsdl:message name="ConsultarCursoInput">
        <wsdl:part name="parameters"
                   element="tns:ConsultarCursoRequest"/>
    </wsdl:message>

    <wsdl:message name="ConsultarCursoOutput">
        <wsdl:part name="parameters"
                   element="tns:ConsultarCursoResponse"/>
    </wsdl:message>

    <wsdl:portType name="CursoPortType">
        <wsdl:operation name="ConsultarCurso">
            <wsdl:input message="tns:ConsultarCursoInput"/>
            <wsdl:output message="tns:ConsultarCursoOutput"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="CursoBinding"
                  type="tns:CursoPortType">

        <soap:binding
                style="document"
                transport="http://schemas.xmlsoap.org/soap/http"/>

        <wsdl:operation name="ConsultarCurso">
            <soap:operation
                    soapAction="http://una.ac.cr/gimnasio/soap/cursos/ConsultarCurso"/>

            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>

            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="CursoService">
        <wsdl:port name="CursoPort"
                   binding="tns:CursoBinding">

            <soap:address
                    location="http://localhost:8080/ws/cursos"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
